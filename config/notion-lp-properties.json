{
  "_comment": "NotionのLPリサーチライブラリー（データソースID: 環境変数 NOTION_LP_DATA_SOURCE_ID）に実在するプロパティ名・型の対応表。実際のNotion側のプロパティ名・型と異なる場合は、このファイルだけを編集すればよい（コードは変更不要）。typeはNotion APIのプロパティタイプ（title/rich_text/url/date/select/checkbox/multi_select）に対応する。",
  "matchProperty": "タイトル",
  "matchOperator": "contains",
  "properties": {
    "title": { "notionName": "タイトル", "type": "title" },
    "brand": { "notionName": "ブランド", "type": "rich_text" },
    "referenceUrl": { "notionName": "参考URL", "type": "url" },
    "source": { "notionName": "出典", "type": "rich_text" },
    "capturedAt": { "notionName": "取得日", "type": "date" },
    "status": { "notionName": "ステータス", "type": "status" },
    "analysisDone": { "notionName": "分析完了", "type": "checkbox" },
    "notionSynced": { "notionName": "Notion同期", "type": "checkbox" },
    "cbsSyncStatus": { "notionName": "CBS同期状態", "type": "select" },
    "knowledgeStatus": { "notionName": "ナレッジ化ステータス", "type": "select" },
    "dropboxPath": { "notionName": "Dropbox正本パス", "type": "rich_text" },
    "mainAppeal": { "notionName": "メイン訴求", "type": "rich_text" },
    "productType": { "notionName": "商材", "type": "multi_select" },
    "category": { "notionName": "カテゴリ", "type": "select" },
    "industryTags": { "notionName": "業種タグ", "type": "multi_select" },
    "colorTags": { "notionName": "配色タグ", "type": "multi_select" },
    "layoutTags": { "notionName": "レイアウトタグ", "type": "multi_select" },
    "copyTypeTags": { "notionName": "コピータイプ", "type": "multi_select" },
    "progressNote": { "notionName": "進捗メモ", "type": "rich_text" }
  }
}
