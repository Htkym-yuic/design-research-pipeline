{
  "_comment": "DIS日次学習ワークフローの設定。既存の日次パイプライン（design-research-daily.yml）とは独立。sources[].termsStatus が 'known' 以外の参照元は候補化しない（規約不明はスキップ）。参照元の規約確認後に 'known' へ変更すること。",
  "version": "1.0.0",
  "timezone": "Asia/Tokyo",
  "maxCandidatesPerMedia": 5,
  "selectedPerMedia": 1,
  "dedupeWindowDays": 180,
  "minScoreToSelect": 55,
  "idPrefix": "DIS",
  "dropbox": {
    "rootEnv": "DROPBOX_DESIGN_ROOT",
    "defaultRoot": "/design/Design_Research_Library",
    "reviewFolder": "99_Needs_Review",
    "subFolder": "dis-daily"
  },
  "media": {
    "lp": {
      "label": "LP",
      "idCode": "LP",
      "library": "LP_Research_Library",
      "capture": "fullpage-pc-sp",
      "notion": { "collection": "collection://39624d4f-a671-8094-ba0c-000b11fefbd0", "envVar": "NOTION_LP_DATA_SOURCE_ID", "libraryName": "01｜LPリサーチライブラリー" }
    },
    "banner": {
      "label": "バナー",
      "idCode": "BN",
      "library": "Banner_Research_Library",
      "capture": "public-image",
      "notion": { "collection": "collection://01516eed-b32f-464e-bbdf-68bf9e7b87f9", "envVar": "NOTION_BANNER_DATA_SOURCE_ID", "libraryName": "02｜バナーリサーチライブラリー" }
    },
    "web": {
      "label": "Webサイト",
      "idCode": "WB",
      "library": "Web_Research_Library",
      "capture": "fullpage-pc-sp",
      "notion": { "collection": "collection://72c6fadb-ee7b-4721-a04c-e5a73126c09f", "envVar": "NOTION_WEB_DATA_SOURCE_ID", "libraryName": "03｜Webサイトリサーチライブラリー" }
    }
  },
  "sources": [
