    { "key": "lp-advance", "media": "lp", "name": "LP advance", "listUrl": "https://lp-web.com/", "detailPathIncludes": "/lp/", "termsStatus": "unknown" },
    { "key": "wdc-lp", "media": "lp", "name": "Web Design Clip [L]", "listUrl": "https://lp.webdesignclip.com/", "detailPathIncludes": "/", "termsStatus": "unknown" },
    { "key": "sankou-lp", "media": "lp", "name": "SANKOU!", "listUrl": "https://sankoudesign.com/", "detailPathIncludes": "/lp/", "termsStatus": "unknown" },
    { "key": "lp-kanji", "media": "lp", "name": "LP幹事", "listUrl": "https://lp-kanji.com/", "detailPathIncludes": "/", "termsStatus": "unknown" },

    { "key": "sankou-web", "media": "web", "name": "SANKOU!", "listUrl": "https://sankoudesign.com/", "detailPathIncludes": "/web/", "termsStatus": "unknown", "notes": "既存の日次処理（non-lp-sources.json の web）も同サイトを使用。重複除外必須。" },
    { "key": "io3000", "media": "web", "name": "I/O 3000", "listUrl": "https://io3000.com/", "detailPathIncludes": "/", "termsStatus": "unknown" },
