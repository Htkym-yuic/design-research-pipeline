<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>jp.design-research.dis-prep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{REPO}}/scripts/dis/daily-prep.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>{{HOUR}}</integer><key>Minute</key><integer>{{MINUTE}}</integer></dict>
  <key>StandardOutPath</key><string>{{REPO}}/outputs/dis/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/outputs/dis/logs/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
